@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<CategoryPage>
@{
	Layout = "master.cshtml";

	var categoryArticles = Model.Children()
		.OfType<Article>()
		.OrderByDescending(article => article.PublishDate)
		.ToList();
}

<partial name="Partials/Layout/Articles/_ArticleSection" model="categoryArticles"/>