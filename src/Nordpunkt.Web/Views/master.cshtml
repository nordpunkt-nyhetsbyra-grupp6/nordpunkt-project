@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400..800&family=Libre+Franklin:wght@400..700&family=Onest:wght@200;600&family=IBM+Plex+Mono:wght@500;600&display=swap" />
    <link rel="stylesheet" href="/css/output.css" />
    <title>Nordpunkt Nyhetsbyrå</title>
</head>
<body>

    <partial name="Partials/Layout/_Header" />


    <main class="mx-auto flex max-w-3xl flex-col gap-5 py-5 sm:px-6">
        @RenderBody()
    </main>

    <footer class="border-t mt-12 py-6 text-center text-sm text-gray-500">
        &copy; @DateTime.Now.Year Nordpunkt Nyhetsbyrå
    </footer>
</body>
</html>