@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;

	// Standardsidor (Om oss, Kontakt ...) ligger under Home men är inte kategorier
	var footerPages = Model.Root().Children()
		.Where(child => child is not CategoryPage)
		.ToArray();

	var tipPage = Model.Root().Children().OfType<TipPage>().FirstOrDefault();
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400..800&family=Libre+Franklin:wght@400..700&family=Onest:wght@200;600&family=IBM+Plex+Mono:wght@500;600&display=swap" />
    <link rel="stylesheet" href="/css/output.css" />
    <title>Nordpunkt Nyhetsbyrå</title>
</head>
<body>

    <partial name="Partials/Layout/_Header" />


    <main class="mx-auto flex max-w-3xl flex-col gap-5 py-5 sm:px-6">
        @RenderBody()
    </main>

    <footer class="mt-4 bg-np-ink text-white">
        <div class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-8 sm:px-6">
            <div class="flex items-center justify-between gap-3">
                <span class="font-logo text-2xl leading-none tracking-[-0.02em]"><span class="font-extralight">nord</span><span class="font-semibold">punkt</span></span>
                <a href="@tipPage?.Url()" class="grid size-22 shrink-0 place-items-center rounded-full bg-np-red text-xs font-bold tracking-wide whitespace-nowrap text-white uppercase hover:bg-white hover:text-np-red">Tipsa oss!</a>
            </div>

            @if (footerPages.Length > 0)
            {
                <nav aria-label="Om Nordpunkt">
                    <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:flex sm:flex-wrap">
                        @foreach (var footerPage in footerPages)
                        {
                            <li><a href="@footerPage.Url()" class="hover:underline">@footerPage.Name</a></li>
                        }
                    </ul>
                </nav>
            }

            <p class="font-mono text-xs text-white/70">&copy; @DateTime.Now.Year Nordpunkt Nyhetsbyrå</p>
        </div>
    </footer>
</body>
</html>