@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HomePage>
@{
	Layout = "master.cshtml";

	var articles = Model.Root()
		.Descendants()
		.OfType<Article>()
		.OrderByDescending(article => article.PublishDate)
		.ToList();
}

<partial name="Partials/Layout/Articles/_ArticleSection" model="articles" />



