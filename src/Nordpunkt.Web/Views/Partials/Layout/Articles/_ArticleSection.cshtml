@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IEnumerable<Article>>
@{
    var latestArticle = Model.FirstOrDefault();
    var remainingArticles = Model.Skip(1).Take(8);
}

<section class="flex flex-col gap-20">
	<div>
		@if (latestArticle != null)
		{
			<partial name="Partials/Layout/Articles/_FeaturedArticle" model="latestArticle" />
		}
		else
		{
			<h1>INGA NYHETER FÖR TILLFÄLLET</h1>
		}
	</div>

	<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
		@foreach (var article in remainingArticles)
		{
			<partial class="h-full" name="Partials/Layout/Articles/_ArticleCard" model="article" />
		}
	</div>
</section>