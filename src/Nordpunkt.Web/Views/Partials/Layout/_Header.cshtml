@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@using Umbraco.Cms.Core.Routing

@inject IPublishedValueFallback PublishedValueFallback
@inject IPublishedUrlProvider PublishedUrlProvider

@{
    var home = Model.Root();
    var isHome = Model.Id == home.Id;

    var categories = home.Children()
        .OfType<CategoryPage>()
        .Where(x => x.IsVisible(PublishedValueFallback))
        .ToArray();
}

<header class="np-header">
    <div class="mx-auto flex max-w-3xl items-center gap-4 px-4 pt-4 pb-3 sm:px-6">
        <div class="flex min-w-0 flex-1 flex-col gap-3">
            <a href="/" class="flex items-center gap-2.5 self-start" aria-label="Nordpunkt Nyhetsbyrå, till startsidan">
                <img src="/images/nordpunkt-logo.svg" alt="" class="h-10 w-auto" />
                <span class="font-logo text-[1.9rem] leading-none tracking-[-0.02em]"><span class="font-extralight">nord</span><span class="font-semibold">punkt</span></span>
            </a>

            <nav aria-label="Kategorier" class="overflow-x-auto">
                <ul class="flex gap-1.5 whitespace-nowrap font-mono text-[0.7rem] font-semibold tracking-wide uppercase">
                    <li>
                        <a href="@home.Url(PublishedUrlProvider)" aria-current="@(isHome ? "page" : null)"
                           class="inline-flex items-center rounded-sm px-2.5 py-1 @(isHome ? "bg-np-ink text-white" : "border border-np-ink/20 hover:border-np-ink")">@home.Name</a>
                    </li>
                    @foreach (var category in categories)
                    {
                        var isActive = category.IsAncestorOrSelf(Model);
                        var color = category.Value<string>("color") ?? "#2a2a35";

                        <li>
                            <a href="@category.Url(PublishedUrlProvider)" aria-current="@(isActive ? "page" : null)"
                               class="inline-flex items-center gap-1.5 rounded-sm px-2.5 py-1 @(isActive ? "bg-np-ink text-white" : "border border-np-ink/20 hover:border-np-ink")">
                                <span class="size-2 rounded-full" style="background: @color"></span>
                                @category.Name
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

        @* TODO: länka till formulärsidan "Tipsa redaktionen" när den finns *@
        <a href="#" class="grid size-22 shrink-0 place-items-center rounded-full bg-np-red text-xs font-bold tracking-wide whitespace-nowrap text-white uppercase hover:bg-np-ink">Tipsa oss!</a>
    </div>
</header>
